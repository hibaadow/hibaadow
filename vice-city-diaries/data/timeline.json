{"fps": 30, "duration": 90.0, "lines": [{"i": 0, "speaker": "lucia_vo", "name": "LUCIA", "text": "Everybody in Vice City wants to be somebody.", "start": 1.4, "dur": 2.758}, {"i": 1, "speaker": "lucia_vo", "name": "LUCIA", "text": "But nobody talks about what it costs.", "start": 5.0, "dur": 1.948}, {"i": 2, "speaker": "caller", "name": "UNKNOWN NUMBER", "text": "You still owe me.", "start": 15.3, "dur": 1.41}, {"i": 3, "speaker": "lucia", "name": "LUCIA", "text": "I thought we were done.", "start": 17.3, "dur": 1.078}, {"i": 4, "speaker": "caller", "name": "UNKNOWN NUMBER", "text": "We were. Until you disappeared with something that wasn't yours.", "start": 19.4, "dur": 3.742}, {"i": 5, "speaker": "lucia", "name": "LUCIA", "text": "Then I guess you should come find me.", "start": 24.4, "dur": 1.81}, {"i": 6, "speaker": "jason", "name": "JASON", "text": "Please tell me you didn't just make another enemy.", "start": 35.7, "dur": 2.578}, {"i": 7, "speaker": "lucia", "name": "LUCIA", "text": "I didn't make him. He was already one.", "start": 38.8, "dur": 2.033}, {"i": 8, "speaker": "jason", "name": "JASON", "text": "What did you do?", "start": 41.3, "dur": 0.86}, {"i": 9, "speaker": "lucia", "name": "LUCIA", "text": "Something we need to talk about somewhere else.", "start": 42.5, "dur": 2.051}, {"i": 10, "speaker": "jason", "name": "JASON", "text": "Lucia, what's in the bag?", "start": 47.6, "dur": 1.337}, {"i": 11, "speaker": "jason", "name": "JASON", "text": "Lucia.", "start": 51.3, "dur": 0.729}, {"i": 12, "speaker": "jason", "name": "JASON", "text": "Where did you get that?", "start": 55.7, "dur": 1.032}, {"i": 13, "speaker": "lucia", "name": "LUCIA", "text": "Let's just say somebody made a very expensive mistake.", "start": 57.4, "dur": 3.053}, {"i": 14, "speaker": "jason", "name": "JASON", "text": "Lucia... we're being followed.", "start": 66.6, "dur": 1.472}, {"i": 15, "speaker": "lucia", "name": "LUCIA", "text": "Keep driving.", "start": 82.4, "dur": 0.908}], 