# Copy to deploy/production.env (git-ignored) and fill in. Keep secrets in the host's secret store
# where possible; never commit production.env.
USE_MOCK_AI=true                      # set false once ANTHROPIC_API_KEY is in place and Phase 1 is done
ANTHROPIC_API_KEY=
OPSENGINE_SECURE_COOKIES=1            # cookies only over HTTPS
OPSENGINE_TRUST_PROXY=1               # trust Caddy's X-Forwarded-* headers (only behind the proxy)
OPSENGINE_REQUIRE_SIGNED_RULES=true   # refuse to run on rules a competent person hasn't signed off
OPSENGINE_CHECKPOINT_KEY=             # 32+ random characters; store a copy somewhere safe and separate
EMAIL_MODE=outbox                     # smtp once an email provider is set up (Phase 3)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
OPSENGINE_PUBLIC_URL=https://portal.example.ie   # used in one-time approval links in emails
OPSENGINE_WEBHOOK_SECRET=             # 32+ random characters; your email provider signs delivery reports with it
# Inbound email (documents sent to docs+<customer id>@your domain). Leave empty to use a mail-drop folder instead.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# WhatsApp Business (Meta Cloud API). queue = nothing sent until the account is approved.
WHATSAPP_MODE=queue
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                  # checks that webhooks really come from Meta
WHATSAPP_VERIFY_TOKEN=                # any long random string; also entered in Meta's webhook settings
WHATSAPP_TEMPLATE=opsengine_message   # approved template: "You have a message from {{2}} about {{3}}. Reply to this message to see it."
# AI: Claude on Google Cloud Vertex AI, EU multi-region. Keep USE_MOCK_AI=true until the photo reader is
# validated on real documents (Phase 1); then set USE_MOCK_AI=false.
AI_PROVIDER=vertex
VERTEX_PROJECT_ID=
VERTEX_REGION=eu
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/vertex-service-account.json   # mount the key file; never commit it
OPSENGINE_MODEL=claude-sonnet-5-5
OPSENGINE_VISION_MODEL=claude-opus-5-5
