# OpsEngine settings. Copy this file to .env (same folder) and fill it in:
#     cp .env.example .env
# .env is git-ignored: never commit a real key. Real environment variables override .env.

# Claude API key from https://platform.claude.com/settings/keys
# Leave empty until you have one.
ANTHROPIC_API_KEY=

# true  = never call Claude. Sample photos get recorded reads; real photos go to human review;
#         translations are flagged [TRANSLATION NEEDED]; drafts use the template.
# false = use Claude when ANTHROPIC_API_KEY is set.
USE_MOCK_AI=true

# Optional model overrides
# OPSENGINE_MODEL=claude-sonnet-5-5
# OPSENGINE_VISION_MODEL=claude-opus-5-5

# Email sending. outbox = nothing leaves this machine (a person sends from the outbox folder).
# smtp = also send email through your mail provider. WhatsApp has no connector yet.
EMAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587   # 465 = SSL, anything else = STARTTLS
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Replies come back to inbox+<customer>.<issue>@yourdomain (your mailbox must accept plus addressing)
EMAIL_REPLY_TO=

# Inbound email (python -m opsengine inbox, every 5 minutes on the server)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Approve-by-link and the public address of the portal
# OPSENGINE_SECRET: run  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OPSENGINE_SECRET=
PUBLIC_URL=https://app.example.ie

# Server: failure alerts and backup encryption (deploy/SETUP.md)
ALERT_EMAIL=
BACKUP_PASSPHRASE=
