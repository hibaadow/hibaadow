# OpsEngine settings. Copy this file to .env (same folder) and fill it in:
#     cp .env.example .env
# .env is git-ignored: never commit a real key. Real environment variables override .env.

# Claude API key from https://platform.claude.com/settings/keys
# Leave empty until you have one.
ANTHROPIC_API_KEY=

# true  = never call Claude. Sample photos get recorded reads; real photos go to human review;
#         translations are flagged [TRANSLATION NEEDED]; drafts use the template.
# false = use Claude when ANTHROPIC_API_KEY is set.
USE_MOCK_AI=true

# Optional model overrides
# OPSENGINE_MODEL=claude-sonnet-5-5
# OPSENGINE_VISION_MODEL=claude-opus-5-5
