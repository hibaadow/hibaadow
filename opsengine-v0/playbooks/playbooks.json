{
  "_about": "Playbooks: for each requirement (and optionally each issue category), the ordered steps that resolve it. 'approval' names who must approve before the step runs (customer | safety_reviewer | ops). 'waits_for': 'document' pauses until proof is ingested.",
  "_default": {
    "validity": [
      {
        "action": "request_document",
        "from": "customer",
        "template": "generic_document_request",
        "waits_for": "document"
      },
      {
        "action": "verify"
      },
      {
        "action": "distribute"
      }
    ],
