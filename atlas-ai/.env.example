# ======================= ATLAS AI configuration =======================
# Copy to .env (docker compose) or backend/.env (local dev). NEVER commit .env.

# --- Core -------------------------------------------------------------
ATLAS_ENV=production                       # development | production
POSTGRES_PASSWORD=change-me-strong-db-password
# Local dev only (docker compose sets this automatically):
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas:<password>@localhost:5432/atlas
# ATLAS_REDIS_URL=redis://localhost:6379/0

# 64+ random bytes, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(64))"
ATLAS_SECRET_KEY=
ATLAS_SESSION_TTL_MINUTES=720
ATLAS_COOKIE_SECURE=false                  # set true behind HTTPS
ATLAS_CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# First admin account (created only when the users table is empty). Remove after first start.
ATLAS_ADMIN_USERNAME=admin
ATLAS_ADMIN_PASSWORD=

# Run the trading engine inside the API process (single-process dev). docker compose uses a separate worker.
ATLAS_EMBEDDED_WORKER=true

# --- Market data (public endpoints, no keys required) -----------------
# ATLAS_BINANCE_REST_URL=https://data-api.binance.vision
# ATLAS_COINBASE_REST_URL=https://api.exchange.coinbase.com
# ATLAS_COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
# ATLAS_KRAKEN_REST_URL=https://api.kraken.com
# ATLAS_KRAKEN_WS_URL=wss://ws.kraken.com/v2
# ATLAS_DEXSCREENER_URL=https://api.dexscreener.com
# ATLAS_JUPITER_URL=https://lite-api.jup.ag
# Public Solana RPC is heavily rate-limited; use a dedicated provider URL (Helius, Triton, QuickNode…) for full holder checks:
# ATLAS_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ATLAS_ENABLE_WEBSOCKETS=true

# --- Optional: AI commentary (Claude) ---------------------------------
# Commentary is advisory text only and never affects execution.
ANTHROPIC_API_KEY=
ATLAS_AI_COMMENTARY_MODEL=claude-opus-5-5

# --- Live trading (DISABLED by default) -------------------------------
# Both the operator gate below AND an admin "arm" action in the UI are required.
ATLAS_LIVE_TRADING_ALLOWED=false
# Path to a solana-keygen JSON keypair mounted as a secret file (chmod 600). Seed phrases are never accepted.
# ATLAS_SOLANA_KEYPAIR_PATH=/run/secrets/solana-keypair.json
