# ================= ATLAS AI — Gold (XAU/USD) & Forex configuration =================
# Copy to .env (docker compose) or backend/.env (local dev). NEVER commit .env.

# --- Core -----------------------------------------------------------------------
ATLAS_ENV=production                       # development | production
POSTGRES_PASSWORD=change-me-strong-db-password
# Local dev only (docker compose sets these automatically):
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas:<password>@localhost:5432/atlas
# ATLAS_REDIS_URL=redis://localhost:6379/0

# 64+ random bytes:  python -c "import secrets; print(secrets.token_urlsafe(64))"
ATLAS_SECRET_KEY=
ATLAS_SESSION_TTL_MINUTES=720
ATLAS_COOKIE_SECURE=false                  # true behind HTTPS
ATLAS_CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# First admin (created only when no users exist). Remove after first start.
ATLAS_ADMIN_USERNAME=admin
ATLAS_ADMIN_PASSWORD=

# Run the trading engine inside the API process (single-process dev). docker compose runs a separate worker.
ATLAS_EMBEDDED_WORKER=true

# --- Market data & broker ---------------------------------------------------------
# ATLAS_DATA_SOURCE: where candles + live prices come from
#   public = Swissquote public quotes (no credentials; ATLAS builds sampled 1-minute bars as it runs)
#   oanda  = OANDA v20 (full bid/ask candle history + live prices)
#   mt5    = MetaTrader 5 via the ATLAS MT5 bridge (see bridge/README.md)
ATLAS_DATA_SOURCE=public
# ATLAS_BROKER: where demo/live orders are sent (none = paper trading only)
ATLAS_BROKER=none

# OANDA v20 — practice (demo) environment by default. Create a token in your OANDA account (Manage API Access).
ATLAS_OANDA_ENVIRONMENT=practice           # practice | live
ATLAS_OANDA_TOKEN=
ATLAS_OANDA_ACCOUNT_ID=                    # e.g. 101-001-1234567-001

# MetaTrader 5 bridge (runs on the Windows machine next to your logged-in MT5 terminal).
# Your MT5 login/password stay in the terminal — ATLAS never stores them.
ATLAS_MT5_BRIDGE_URL=                      # e.g. http://10.0.0.5:8765 (VPN / tunnel only)
ATLAS_MT5_BRIDGE_TOKEN=                    # same value as ATLAS_BRIDGE_TOKEN on the bridge
ATLAS_MT5_SYMBOL_SUFFIX=                   # e.g. ".a" if your broker names symbols EURUSD.a
ATLAS_MT5_MAGIC=770077

# Public sources (keyless). Defaults shown.
# ATLAS_PUBLIC_QUOTES_URL=https://forex-data-feed.swissquote.com
# ATLAS_PUBLIC_QUOTE_INTERVAL_SECONDS=10
# ATLAS_CALENDAR_URL=https://nfs.faireconomy.media      # economic calendar (ForexFactory export)
# US 10Y yield: FRED DGS10 (fred.stlouisfed.org), no key required

# --- Optional: AI commentary (Claude) -----------------------------------------------
# Advisory narrative on executed decisions; never affects execution.
ANTHROPIC_API_KEY=
ATLAS_AI_COMMENTARY_MODEL=claude-opus-5-5

# --- Live (real-money) accounts — DISABLED by default -------------------------------
# Required in addition to: a live broker account, ATLAS_BROKER, and an admin "arm" action in the UI.
ATLAS_LIVE_TRADING_ALLOWED=false
